local randomLoadingTime = math.random(300, 500) / 100 -- 3초 ~ 5초
local startTime = tick()
local isFinished = false

local connection
connection = RunService.RenderStepped:Connect(function(dt)
	for _, flake in ipairs(snowflakes) do
		local pos = flake.instance.Position
		local newY = pos.Y.Scale + flake.speed * dt
		local newX = pos.X.Scale + flake.drift * dt
		if newY > 1.1 then newY = -0.1 end
		if newX > 1.1 then newX = -0.1 elseif newX < -0.1 then newX = 1.1 end
		flake.instance.Position = UDim2.new(newX, 0, newY, 0)
	end
	
	if isFinished then return end
	
	local elapsedTime = tick() - startTime
	local progress = math.clamp(elapsedTime / randomLoadingTime, 0, 1)
	

-- 공통 클릭 사운드 재생 함수
local function playClickSound()
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://4590657391"
	sound.Volume = 1
	sound.Parent = SoundService
	sound:Play()
	
	-- 재생 끝나면 사운드 인스턴스 자동 삭제
	task.delay(1, function()
		if sound then sound:Destroy() end
	end)
end

